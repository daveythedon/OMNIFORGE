            )}
            <button onClick={() => setSelectedJob(null)}
                    className="mt-6 w-full bg-gray-200 text-gray-700 py-2 rounded hover:bg-gray-300">
              Close
            </button>
          </div>
        </div>
      )}
    </div>
  );
};

export default TradeFlowMVP;
