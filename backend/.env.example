# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/tradeflow
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradeflow
DB_USER=user
DB_PASSWORD=password

# Server Configuration
PORT=3001
NODE_ENV=development

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Third-Party Service Keys (Connect these later)
# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# SendGrid Email
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@tradeflow.com

# Google Calendar
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# OpenAI for AI Insights
OPENAI_API_KEY=sk-your_openai_key

# n8n Webhook Base URL
N8N_WEBHOOK_BASE_URL=https://n8n.yourdomain.com/webhook

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Secret (if needed for custom tokens)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
